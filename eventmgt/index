@{
    ViewData["Title"] = "SurveyJS App";
}

<div class="container">
    <h2>Welcome to SurveyJS</h2>
    <p>Select an option:</p>
    <a href="@Url.Action("AllSurveys", "Home")" class="btn btn-primary me-2">View All Surveys</a>
    <a href="@Url.Action("CreateSurvey", "Home")" class="btn btn-success">Create New Survey</a>
    <div id="surveyList" class="mt-3"></div>
    <div id="surveyContainer"></div>
</div>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" />

<!-- jQuery and SurveyJS 1.12.44 -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
<script src="https://unpkg.com/survey-jquery@1.12.44/survey.jquery.min.js"></script>
<link href="https://unpkg.com/survey-core@1.12.44/modern.min.css" rel="stylesheet" />

<script>
    $(document).ready(function () {
        if (typeof Survey === 'undefined') {
            console.error('SurveyJS not defined.');
            return;
        }
        loadSurveys();
    });

    function loadSurveys() {
        const basePath = '@Url.Content("~/")'.replace(/\/$/, '');
        fetch(`${basePath}/api/surveys`)
            .then(r => {
                if (!r.ok) throw new Error(`HTTP ${r.status}: Failed to fetch surveys`);
                return r.json();
            })
            .then(surveys => {
                const html = surveys.map(s =>
                    `<button class="btn btn-primary me-2 mb-2" onclick="loadSurvey(${s.id})">${s.title}</button>`
                ).join('');
                $('#surveyList').html(html);
            })
            .catch(error => {
                console.error('Error fetching surveys:', error);
                $('#surveyList').html('<p class="text-danger">Failed to load surveys.</p>');
            });
    }

    function loadSurvey(id) {
        const basePath = '@Url.Content("~/")'.replace(/\/$/, '');
        fetch(`${basePath}/api/surveys/${id}`)
            .then(r => {
                if (!r.ok) throw new Error(`HTTP ${r.status}: Failed to fetch survey`);
                return r.json();
            })
            .then(data => {
                $('#surveyContainer').html('<div id="surveyElement"></div>');
                var survey = new Survey.Model(JSON.parse(data.jsonData));
                $("#surveyElement").Survey({ model: survey });

                survey.onComplete.add(function (sender) {
                    const answers = sender.data;
                    if (!answers || Object.keys(answers).length === 0) {
                        alert('No survey answers provided.');
                        return;
                    }

                    const payload = {
                        answersJson: JSON.stringify(answers),
                        userAgent: navigator.userAgent,
                        ipAddress: '127.0.0.1',
                        isComplete: true
                    };
                    console.log('Submitting to:', `${basePath}/api/responses/${id}`, 'Payload:', payload);

                    fetch(`${basePath}/api/responses/${id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(response => {
                        const contentType = response.headers.get('content-type');
                        if (contentType && contentType.includes('application/json')) {
                            return response.json().then(data => ({ ok: response.ok, data }));
                        }
                        return { ok: response.ok, data: {} };
                    })
                    .then(({ ok, data }) => {
                        if (ok) {
                            alert('Thank you for completing the survey!');
                            loadSurveys();
                        } else {
                            alert(`Error submitting survey: ${data.message || 'Bad Request'}`);
                        }
                    })
                    .catch(error => {
                        alert('Network error submitting survey.');
                        console.error('Fetch error:', error);
                    });
                });
            })
            .catch(error => {
                console.error('Error loading survey:', error);
                $('#surveyContainer').html('<p class="text-danger">Failed to load survey.</p>');
            });
    }
</script>